# Build StepSSH on OPENSTEP 4.2 (gcc 2.7.2).  Works with NeXT make or GNU make.
#
#   make -f Makefile.openstep test     # FIRST: run the C unit tests on the real compiler
#   make -f Makefile.openstep          # build StepSSH.app
#   make -f Makefile.openstep tools    # build stepssh/stepssh-keygen/stepscp (build/, no AppKit)
#   make -f Makefile.openstep install  # the above into /LocalApps and /usr/local/bin (see below)
#   make -f Makefile.openstep pkg      # StepSSH.pkg for Installer.app (see below; UNVERIFIED)
#   make -f Makefile.openstep fat      # StepSSH.app as an i386+m68k+sparc fat binary (see below)
#   make -f Makefile.openstep fat-tools    # stepssh/stepssh-keygen/stepscp, fat, same arch set
#   make -f Makefile.openstep install-fat  # fat app + fat tools into /LocalApps, /usr/local/bin
#   make -f Makefile.openstep pkg-fat      # StepSSH.pkg with the fat app + fat tools
#   make -f Makefile.openstep clean
#
# No GNU-make features are used (no wildcard, no pattern rules) so the stock
# NeXT make can read it.  Object files are written next to their sources.

CC       = cc
OPT      = -O                     # try:  make -f Makefile.openstep OPT="-O2"   (see tools/optbench.sh)
DEFS     = -DOPENSTEP
ARCHS    =                        # e.g. -arch i386 -arch m68k -arch sparc; see `fat` below
CFLAGS   = $(OPT) -Wall $(DEFS) $(ARCHS) -Icore -Iterm -Iapp
LIBS     = -framework AppKit -framework Foundation
APP      = StepSSH.app
# Keep in step with core/ssh.c's CLIENT_VERSION.
VERSION  = 0.2.0

# Workspace takes an application's icon (and its file-type table) from a read-only __ICON segment
# linked into the executable, not from a file in the .app folder (compare /NextApps/Edit.app, whose
# only non-language files are the executable and some TIFFs).  app/StepSSH.iconheader says which
# icon belongs to the app; app/StepSSH.tiff is the icon (regenerate: python3 tools/gen_icon.py).
ICONHDR   = app/StepSSH.iconheader
ICONTIFF  = app/StepSSH.tiff
ICONFLAGS = -sectcreate __ICON __header $(ICONHDR) -segprot __ICON r r -sectcreate __ICON app $(ICONTIFF)

CORE_OBJS = core/aes.o core/bcrypt.o core/bignum.o core/blowfish.o core/chacha.o core/des.o core/ecc.o core/gcm.o core/hmac.o \
            core/knownhosts.o core/md5.o core/nacl.o core/rng.o core/rsa.o core/sftp.o core/sha1.o core/sha2.o core/ssh.o core/ssh_auth.o \
            core/ssh_chan.o core/ssh_key.o core/wire.o
TERM_OBJS = term/nsenc.o term/vt.o
APP_OBJS  = app/AppController.o app/ConnectController.o app/KeyGenController.o \
            app/PromptPanel.o app/SFTPBrowser.o app/SSHSession.o app/SecretField.o app/TerminalView.o \
            app/UIHelpers.o app/PortForward.o app/PortForwardController.o app/main.o

.SUFFIXES: .c .m .o

.c.o:
	$(CC) $(CFLAGS) -c $< -o $@

.m.o:
	$(CC) $(CFLAGS) -c $< -o $@

all: $(APP)/StepSSH

$(APP)/StepSSH: $(CORE_OBJS) $(TERM_OBJS) $(APP_OBJS) $(ICONHDR) $(ICONTIFF)
	-mkdir $(APP)
	@( cd $(APP) ) >/dev/null 2>&1 || { echo "make: $(APP) is missing or is not a directory:"; ls -ld $(APP); echo "remove it and run make again"; exit 1; }
	$(CC) $(ARCHS) -o $(APP)/StepSSH $(CORE_OBJS) $(TERM_OBJS) $(APP_OBJS) $(ICONFLAGS) $(LIBS) || { echo "make: linking with the __ICON segment failed; retrying without an icon"; $(CC) $(ARCHS) -o $(APP)/StepSSH $(CORE_OBJS) $(TERM_OBJS) $(APP_OBJS) $(LIBS); }

# Show what was linked in: expect a segment __ICON with sections __header and app.
iconcheck:
	otool -l $(APP)/StepSSH | grep -A 3 __ICON

# ---- unit tests (plain C, no AppKit) ----
# NOTE: OPENSTEP's mkdir has no -p option (it would create a directory named "-p").
# Directories are made with a plain  mkdir X  whose failure make ignores (the
# leading '-'), followed by a check that says exactly what is wrong if X still
# isn't a directory.
build/test_crypto: tests/test_crypto.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_crypto tests/test_crypto.c $(CORE_OBJS)

build/test_vt: tests/test_vt.c $(TERM_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_vt tests/test_vt.c $(TERM_OBJS)

build/test_sftp: tests/test_sftp.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_sftp tests/test_sftp.c $(CORE_OBJS)

build/test_bignum: tests/test_bignum.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_bignum tests/test_bignum.c $(CORE_OBJS)

build/test_ecc: tests/test_ecc.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_ecc tests/test_ecc.c $(CORE_OBJS)

build/test_rsa: tests/test_rsa.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/test_rsa tests/test_rsa.c $(CORE_OBJS)

build/bench: tools/bench.c $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/bench tools/bench.c $(CORE_OBJS)

bench: build/bench
	build/bench

test: build/test_crypto build/test_vt build/test_sftp build/test_bignum build/test_ecc build/test_rsa
	build/test_crypto
	build/test_vt
	build/test_sftp
	build/test_bignum
	build/test_ecc
	build/test_rsa

# ---- ancillary command-line tools (stepssh, stepssh-keygen, stepscp) ----
# Plain C, no AppKit: OpenSSH-syntax-compatible SSH/keygen/scp for shell scripts. See tools/*.c
# and README.md's "Command-line tools" section for what each one supports.
tools/clicommon.o: tools/clicommon.c tools/clicommon.h
	$(CC) $(CFLAGS) -c tools/clicommon.c -o tools/clicommon.o

build/stepssh: tools/stepssh.c tools/clicommon.o $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/stepssh tools/stepssh.c tools/clicommon.o $(CORE_OBJS)

build/stepssh-keygen: tools/stepssh-keygen.c tools/clicommon.o $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/stepssh-keygen tools/stepssh-keygen.c tools/clicommon.o $(CORE_OBJS)

build/stepscp: tools/stepscp.c tools/clicommon.o $(CORE_OBJS)
	-mkdir build
	@( cd build ) >/dev/null 2>&1 || { echo "make: build is missing or is not a directory:"; ls -ld build; echo "remove it and run make again"; exit 1; }
	$(CC) $(CFLAGS) -o build/stepscp tools/stepscp.c tools/clicommon.o $(CORE_OBJS)

tools: build/stepssh build/stepssh-keygen build/stepscp

# ---- install ----
# OPENSTEP's own conventions: /LocalApps for a locally-built application (parallel to /NextApps
# for vendor-shipped ones -- see app/StepSSH.iconheader's own comment above), /usr/local/bin for
# command-line tools. Needs write access to both (root, typically, unless yours are configured
# otherwise); if mkdir/cp fails for that reason, su or sudo and try again -- this target does not
# do that itself. UNVERIFIED: written to match OPENSTEP's own directory layout, not yet actually
# run there.
BINDIR = /usr/local/bin
APPDIR = /LocalApps

install: all tools
	-mkdir /usr/local
	-mkdir $(BINDIR)
	cp build/stepssh build/stepssh-keygen build/stepscp $(BINDIR)/
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed: $(BINDIR)/stepssh, $(BINDIR)/stepssh-keygen, $(BINDIR)/stepscp, $(APPDIR)/$(APP)"

# ---- Installer package (.pkg) ----
# Built with the real packaging tool, not a hand-rolled imitation of its output: NEXTSTEP/OPENSTEP's
# Installer.app ships a csh script, /NextAdmin/Installer.app/package, that takes a "fake root" tree
# (the payload, laid out under DefaultLocation as if it were / -- e.g. LocalApps/StepSSH.app for
# DefaultLocation "/") and an ".info" file, and does everything else itself: builds the compressed
# archive, the .bom (bill of materials), and the .sizes file, and drops the finished "<info-file
# basename>.pkg" in the directory `package` was run from. The .info file itself is NOT a NeXT-style
# "{ Key = value; }" property list (an earlier version of this target guessed that, and Workspace
# Manager opened the result as a plain folder instead of handing it to Installer.app -- almost
# certainly because it never went through the real tool that produces the format Workspace actually
# recognises) -- it's plain "Keyword<whitespace>value" lines, one per line: confirmed by both
# "Making Packages I" (NEXTSTEP packaging HOWTO),
# https://web.archive.org/web/20221229175934/http://www.nextcomputers.org/NeXTfiles/Software/NEXTSTEP/Developer/making_nextstep_packages.pdf,
# and a real shipped package's actual .pkg contents (Lighthouse Design's OpenWrite 2.1) -- which
# also confirmed the resulting .pkg is a flat directory of <Name>.bom (binary)/.info (text)/.sizes
# (text: NumFiles/InstalledSize/CompressedSize)/.tar.Z (old `compress`, not gzip), which is what
# `package` should produce here too, and settled DiskName's casing and two optional fields
# (UseUserMask, LongFileNames) the HOWTO didn't mention.
#
#   make -f Makefile.openstep pkg          # StepSSH.pkg: thin app + tools, for Installer.app
#   make -f Makefile.openstep pkg-fat      # same, but the app + tools are i386+m68k+sparc fat
#
# UNVERIFIED: the .pkg *format* is now confirmed against a real shipped package, but running
# /NextAdmin/Installer.app/package itself -- and Installer.app actually accepting what it
# produces -- is not: still not yet tested on a real machine. If `package` doesn't exist at that
# path, or rejects the .info file, report back exactly what happened.
PKG     = StepSSH.pkg
PKGROOT = pkgroot
PKGINFO = StepSSH.info

pkg-assemble:
	rm -rf $(PKG) $(PKGROOT) $(PKGINFO)
	mkdir $(PKGROOT)
	mkdir $(PKGROOT)/LocalApps
	cp -r $(APP) $(PKGROOT)/LocalApps/
	mkdir $(PKGROOT)/usr
	mkdir $(PKGROOT)/usr/local
	mkdir $(PKGROOT)/usr/local/bin
	cp build/stepssh build/stepssh-keygen build/stepscp $(PKGROOT)/usr/local/bin/
	echo "Title            StepSSH" > $(PKGINFO)
	echo "Version          $(VERSION)" >> $(PKGINFO)
	echo "Description      SSH-2 client, plus the stepssh/stepssh-keygen/stepscp command-line tools." >> $(PKGINFO)
	echo "DefaultLocation  /" >> $(PKGINFO)
	echo "DiskName         StepSSH" >> $(PKGINFO)
	echo "Relocatable      NO" >> $(PKGINFO)
	echo "Application      YES" >> $(PKGINFO)
	echo "UseUserMask      YES" >> $(PKGINFO)
	echo "LongFileNames    YES" >> $(PKGINFO)
	/NextAdmin/Installer.app/package $(PKGROOT)/ $(PKGINFO)
	rm -rf $(PKGROOT) $(PKGINFO)
	@echo "built $(PKG) via the real Installer.app/package tool -- still UNVERIFIED end to end, see this target's own comment above"

pkg: all tools pkg-assemble

pkg-fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	$(MAKE) -f Makefile.openstep tools ARCHS="$(FATARCHS)"
	$(MAKE) -f Makefile.openstep pkg-assemble

# ---- optional multi-architecture ("fat") build ----
# NeXT's cc accepts several -arch flags in one invocation: each source is compiled once per
# architecture and the per-arch object code is combined into one fat Mach-O file automatically,
# and linking with the same set of -arch flags produces a fat executable -- the exact mechanism
# Apple's own toolchain later inherited for PowerPC/Intel/Apple Silicon universal binaries. This
# only works if the target architecture's compiler backend is actually installed as part of your
# Developer Tools; the m68k/sparc components were separate from a plain Intel install on some
# OPENSTEP CD sets, and this Makefile has no way to know whether yours has them.
#
#   make -f Makefile.openstep fat-check    # fast: does cc even accept these -arch flags here?
#   make -f Makefile.openstep fat          # full: StepSSH.app as an i386+m68k+sparc fat binary
#   make -f Makefile.openstep fat-tools    # stepssh/stepssh-keygen/stepscp, same fat treatment
#   make -f Makefile.openstep install-fat  # fat app + fat tools into /LocalApps, /usr/local/bin
#   make -f Makefile.openstep fat FATARCHS="-arch i386 -arch m68k"   # a different arch set
#
# UNVERIFIED beyond "it links and lipo reports the right slices": this codebase has so far only
# ever run on i386 (86Box). Nothing here confirms the m68k or sparc slices actually execute --
# LOAD32_BE/STORE32_BE etc. (ssh_types.h) mean the C core never assumes a byte order, but that is
# a design intent, not a proof, and the AppKit/Objective-C layer is completely untested on either
# architecture. Report back exactly what `fat`/`fat-check` print, and separately, what happens if
# you actually get the m68k or sparc slice running on real or emulated hardware.
FATARCHS = -arch i386 -arch m68k -arch sparc

fat-check:
	@echo "int main(void) { return 0; }" > /tmp/ssh_fatcheck.c
	$(CC) $(FATARCHS) -c /tmp/ssh_fatcheck.c -o /tmp/ssh_fatcheck.o
	@echo "compiled for all requested architectures; slices actually present:"
	lipo -info /tmp/ssh_fatcheck.o
	@rm -f /tmp/ssh_fatcheck.c /tmp/ssh_fatcheck.o

fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	@echo "== fat link done; architectures actually present in $(APP)/StepSSH: =="
	lipo -info $(APP)/StepSSH

# Same idea as `fat`, for the command-line tools instead of the app: `tools` already respects
# $(ARCHS) (it flows in through $(CFLAGS)), it just needs a clean first so it isn't linking
# against core/*.o left over from a previous thin build.
fat-tools: clean
	$(MAKE) -f Makefile.openstep tools ARCHS="$(FATARCHS)"
	@echo "== fat tools built; architectures actually present: =="
	lipo -info build/stepssh build/stepssh-keygen build/stepscp

# `fat` and `fat-tools` each do their own `clean` first, so chaining them as two prerequisites of
# one target would have the second one's clean delete the first one's output before it gets
# installed. One `clean`, then both sub-builds, avoids that.
install-fat: clean
	$(MAKE) -f Makefile.openstep all ARCHS="$(FATARCHS)"
	$(MAKE) -f Makefile.openstep tools ARCHS="$(FATARCHS)"
	-mkdir /usr/local
	-mkdir $(BINDIR)
	cp build/stepssh build/stepssh-keygen build/stepscp $(BINDIR)/
	-mkdir $(APPDIR)
	rm -rf $(APPDIR)/$(APP)
	cp -r $(APP) $(APPDIR)/
	@echo "installed fat (i386+m68k+sparc) binaries: $(BINDIR)/stepssh, $(BINDIR)/stepssh-keygen, $(BINDIR)/stepscp, $(APPDIR)/$(APP)"

clean:
	rm -f core/*.o term/*.o app/*.o tools/*.o
	rm -rf build $(APP) $(PKG) $(PKGROOT) $(PKGINFO)
